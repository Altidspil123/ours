# ─────────────────────────────────────────────────────────────
#  ours. — the three secrets your app needs
#
#  Local:  copy this file to .env and fill in your values
#  Vercel: paste these into Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# 1. Neon Postgres connection string (from neon.tech dashboard)
#    Looks like: postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/ours?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/ours?sslmode=require"

# 2. The code you both type at the lock screen — pick something yours
APP_PASSCODE="forever"

# 3. Any long random string (signs the login cookie, keep it secret).
#    Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# 4. Web push keys — needed for notifications when the app is CLOSED.
#    Generate a pair once with:  npx web-push generate-vapid-keys
#    Then paste both values here (and the same two vars into Vercel).
#    Without them the app still alerts you whenever it's open — this just
#    adds the magic "phone buzzes in your pocket" layer.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
